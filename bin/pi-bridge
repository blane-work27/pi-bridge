#!/bin/bash
set -euo pipefail
PI_CONFIG_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export PI_CODING_AGENT_DIR="$PI_CONFIG_DIR"
export PI_TELEMETRY=0
[ -f "$PI_CONFIG_DIR/settings.json" ] || { echo "pi-bridge: settings.json is missing. Run $PI_CONFIG_DIR/install.sh." >&2; exit 1; }
unset ANTHROPIC_BASE_URL ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_OAUTH_TOKEN
if [ -z "${PI_BIN:-}" ] && [ -f "$PI_CONFIG_DIR/.env" ]; then
  PI_BIN="$(sed -n 's/^PI_BIN=//p' "$PI_CONFIG_DIR/.env" | tail -1)"
fi
PI_BIN="${PI_BIN:-$(command -v pi)}"
exec "$PI_BIN" "$@"
